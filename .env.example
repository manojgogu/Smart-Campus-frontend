# Local Development (leave empty or use local backend)
# VITE_API_URL=http://localhost:5000/api
# VITE_SOCKET_URL=http://localhost:5000

# Vercel Production Deployment:
# Set this in your Vercel Project Settings -> Environment Variables.
# Replace with your deployed backend URL (e.g. from Render or Railway):
VITE_API_URL=https://smart-campus-api.onrender.com/api
VITE_SOCKET_URL=https://smart-campus-api.onrender.com
